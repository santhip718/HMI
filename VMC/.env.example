# ==============================================================================
# VMC Operator HMI - Environment Variables (EXAMPLE ONLY - DO NOT USE REAL VALUES)
# ==============================================================================
# Copy to `.env` and fill in real values for local docker-compose.
# NEVER commit a real `.env` file. The `.env` file is git-ignored.
#
# For plain `dotnet run` local development, prefer `dotnet user-secrets` instead:
#   cd backend/src/VmcHmi.Api
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<connection>"
#   dotnet user-secrets set "Jwt:SigningKey" "<long random string>"
# ==============================================================================

# --- JWT ---------------------------------------------------------------------
# Long random signing key (>= 32 chars). REQUIRED in production.
# In `dotnet run` / user-secrets it is Jwt:SigningKey.
# In docker-compose it is injected from this .env file into JWT__SIGNINGKEY.
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-characters

# --- Database (used by docker-compose / Render) ------------------------------
# Local-only development password. Use a strong value locally and on deployment.
DB_PASSWORD=replace-with-your-local-postgres-password

# --- Frontend origin allowed by CORS -----------------------------------------
# Full URL of the frontend (e.g. http://localhost:80, or the Render URL).
FRONTEND_URL=http://localhost:80
