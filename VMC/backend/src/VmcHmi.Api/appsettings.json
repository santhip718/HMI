{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}" } },
      { "Name": "File", "Args": { "path": "Logs/hmi-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "VmcHmi.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=learning_portal;Username=postgres;Password=postgres;SearchPath=hmi"
  },
  "Jwt": {
    "Issuer": "VmcHmi.Api",
    "Audience": "VmcHmi.Frontend",
    "SigningKey": "VmcHmi_SuperSecretSigningKey_ForDevelopmentAndProductionFallback_2026!"
  },
  "FrontendUrl": "http://localhost:5173"
}
